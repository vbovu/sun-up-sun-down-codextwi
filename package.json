{
  "name": "sun-up-sun-down-twitch-slice",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts --dev",
    "start": "node --import tsx server.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test src/core/engine.test.ts src/audience/knightAid.test.ts src/experience/*.test.ts server/*.test.ts",
    "test:browser": "node --import tsx scripts/browser-journey.mjs",
    "test:browser:regressions": "node --import tsx scripts/browser-continuation-regressions.mjs",
    "check:secrets": "node scripts/secret-scan.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
